{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build wxWidgets App",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-stdlib=libc++",
                "main.cpp", 
                "`wx-config --cxxflags --libs`",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
